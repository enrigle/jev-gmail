<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.enrigle.jev-gmail</string>

    <!-- uv loads the API key from .env; no secrets in this file. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/enrigle/.local/bin/uv</string>
        <string>run</string>
        <string>--env-file</string>
        <string>.env</string>
        <string>gmail_jev_sorter.py</string>
        <string>--apply</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/enrigle/Documents/code/jev-gmail</string>

    <!-- Sunday (0) at 21:00, local time. Evening: laptop usually awake.
         Kept off the wallabump nights (Mon/Fri 22:25). If the Mac is asleep,
         launchd runs it on next wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>21</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/enrigle/Library/Logs/jev-gmail.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/enrigle/Library/Logs/jev-gmail.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
