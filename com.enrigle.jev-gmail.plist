<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.enrigle.jev-gmail</string>

    <!-- uv loads the API key from .env; no secrets in this file. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/enrigle/.local/bin/uv</string>
        <string>run</string>
        <string>--env-file</string>
        <string>.env</string>
        <string>gmail_jev_sorter.py</string>
        <string>--apply</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/enrigle/Documents/code/jev-gmail</string>

    <!-- Every other day: odd days of the month (1, 3, ... 31) at 21:30, local time.
         ponytail: 31st then 1st runs two days in a row; StartInterval would drift instead.
         If the Mac is asleep, launchd runs it on next wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>3</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>5</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>7</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>9</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>13</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>15</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>17</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>19</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>21</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>23</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>25</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>27</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>29</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Day</key><integer>31</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <!-- Unbuffered output: the log fills live instead of only at exit. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/enrigle/Library/Logs/jev-gmail.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/enrigle/Library/Logs/jev-gmail.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
